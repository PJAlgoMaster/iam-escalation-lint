{
  "RoleName": "build-release",
  "PolicyName": "deploy-pipeline",
  "Document": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ShipFunctions",
        "Effect": "Allow",
        "Action": ["lambda:CreateFunction", "lambda:UpdateFunctionCode"],
        "Resource": "arn:aws:lambda:ap-south-1:111122223333:function:release-*"
      },
      {
        "Sid": "HandRoleToLambda",
        "Effect": "Allow",
        "Action": "iam:PassRole",
        "Resource": "arn:aws:iam::111122223333:role/release-runner"
      }
    ]
  }
}