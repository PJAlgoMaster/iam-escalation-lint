{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventsTable",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:ap-south-1:111122223333:table/events"
    },
    {
      "Sid": "OpsTools",
      "Effect": "Allow",
      "Action": ["ec2:TerminateInstances", "ec2:StopInstances"],
      "Resource": "*"
    }
  ]
}