{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAllReports",
      "Effect": "Allow",
      "Action": ["s3:Get*", "s3:List*"],
      "Resource": "*"
    },
    {
      "Sid": "WriteOwnPrefix",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::reports/*"
    }
  ]
}